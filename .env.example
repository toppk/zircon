# Local development example. Put real secrets in a private .env file; never commit it.
PORT=3000
PUBLIC_BASE_URL=https://zircon.chooser.us
STATE_DIR=/var/lib/zircon
MAX_USERS=16

# GitHub OAuth app for signing people in.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-a-host-generated-secret-at-least-32-characters

# Zircon OAuth client configured in the Custom GPT Action.
OAUTH_CLIENT_ID=zircon-chatgpt
OAUTH_CLIENT_SECRET=replace-with-a-host-generated-secret-at-least-32-characters
OAUTH_REDIRECT_URIS=https://chatgpt.com/aip/g-your-gpt-id/oauth/callback
SESSION_SECRET=replace-with-a-host-generated-secret-at-least-32-characters
ADMIN_TOKEN=replace-with-a-host-generated-secret-at-least-32-characters

# ZNC control connection, loopback only. Admin account needs controlpanel.
ZNC_HOST=127.0.0.1
ZNC_PORT=6667
ZNC_ADMIN_USER=zirconctl
ZNC_ADMIN_PASSWORD=replace-with-the-host-generated-znc-admin-password
ZNC_USER_SECRET=replace-with-a-host-generated-secret-at-least-32-characters

# Owner-approved IRC networks. TLS is required for upstream connections.
IRC_NETWORKS_JSON='[{"name":"chonkbase","host":"irc.chonkbase.net","port":6697,"tls":true}]'
IRC_CHANNELS="#soup"
IRC_USERNAME=zircon
IRC_REALNAME=Zircon ChatGPT bridge
