# The NixOS module sets non-secret values. This file shows the equivalent
# values for local development; never commit a filled-in .env file.
PORT=3000
PUBLIC_BASE_URL=https://zircon.chooser.us

# OpenID Connect issuer and API audience from your identity provider.
OIDC_ISSUER=https://your-tenant.example.com/
OIDC_AUDIENCE=https://zircon.chooser.us
OIDC_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
# Comma-separated identity provider subject IDs allowed to use Zircon.
# Use * only if your provider independently restricts API access to intended users.
OIDC_ALLOWED_SUBJECTS=your-provider-user-id

ZNC_HOST=127.0.0.1
ZNC_PORT=6667
ZNC_USER=zircon
ZNC_NETWORK=chonkbase
ZNC_PASSWORD=your-znc-password
IRC_NICK=zircon
IRC_USERNAME=zircon
IRC_REALNAME=Zircon ChatGPT bridge
IRC_CHANNELS=#soup
